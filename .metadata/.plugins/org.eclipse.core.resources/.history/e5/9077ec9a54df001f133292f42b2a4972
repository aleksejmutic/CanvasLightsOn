package canvas;

import javax.swing.*;
import java.awt.*;

public class MainFrame extends JFrame {
    private Canvas canvas;
    private JunctionBoxMouseListener junctionBoxMouseListener;
    private WireMouseListener wireMouseListener;

    public MainFrame() {
        setTitle("Circuit Editor");
        setSize(800, 600);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new BorderLayout());

        canvas = new Canvas();

        junctionBoxMouseListener = new JunctionBoxMouseListener(canvas);
        wireMouseListener = new WireMouseListener(canvas);

        canvas.addMouseListener(junctionBoxMouseListener);
        canvas.addMouseListener(wireMouseListener);

        ButtonsPanel buttonsPanel = new ButtonsPanel(
            e -> {
                junctionBoxMouseListener.setDrawing(true);
                canvas.setDrawingCursor();
            },
            e -> {
                wireMouseListener.setDrawing(true);  // Add this line for wire drawing mode
            }
        );

        add(buttonsPanel, BorderLayout.NORTH);
        add(canvas, BorderLayout.CENTER);

        setVisible(true);
    }
}
