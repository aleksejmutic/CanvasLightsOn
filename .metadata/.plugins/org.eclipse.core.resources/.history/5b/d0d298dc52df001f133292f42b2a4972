package canvas;

import java.awt.*;

public class JunctionBox {
    private int x, y, width, height;
    private Color color = Color.WHITE;
    private JunctionPoint[] junctionPoints;  // Array to store the JunctionPoints

    public JunctionBox(int x, int y, int width, int height) {
        this.x = x;
        this.y = y;

        // Swap width and height for portrait orientation
        this.width = height;
        this.height = width;

        this.junctionPoints = new JunctionPoint[4];

        // Create junction points at the center of each side of the portrait rectangle
        junctionPoints[0] = new JunctionPoint(x + this.width / 2, y); // Top (center of width)
        junctionPoints[1] = new JunctionPoint(x + this.width, y + this.height / 2); // Right (center of height)
        junctionPoints[2] = new JunctionPoint(x + this.width / 2, y + this.height); // Bottom (center of width)
        junctionPoints[3] = new JunctionPoint(x, y + this.height / 2); // Left (center of height)
    }

    public JunctionPoint[] getJunctionPoints() {
        return junctionPoints;
    }

    public void draw(Graphics g) {
        g.setColor(Color.BLACK);
        g.drawRect(x, y, width, height);
        g.setColor(color);
        g.fillRect(x + 1, y + 1, width - 1, height - 1);

        for (JunctionPoint point : junctionPoints) {
            point.draw(g);
        }
    }
}
