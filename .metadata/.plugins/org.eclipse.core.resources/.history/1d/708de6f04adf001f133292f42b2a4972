package canvas;

import javax.swing.*;
import java.awt.*;
import java.util.ArrayList;

public class Canvas extends JPanel {
    private ArrayList<JunctionBox> junctionBoxes;  // Store drawn JunctionBoxes

    public Canvas() {
        setPreferredSize(new Dimension(800, 500));  // Size of the canvas area
        setBackground(Color.WHITE);  // Set background color
        junctionBoxes = new ArrayList<>();
    }

    // Method to add a JunctionBox to the list
    public void addJunctionBox(JunctionBox junctionBox) {
        junctionBoxes.add(junctionBox);
        repaint();  // Trigger a repaint to update the drawing
    }

    // Method to set the drawing cursor (to indicate drawing mode)
    public void setDrawingCursor() {
        setCursor(Cursor.getPredefinedCursor(Cursor.CROSSHAIR_CURSOR));  // Change cursor to crosshair
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);

        // Draw each JunctionBox
        for (JunctionBox junctionBox : junctionBoxes) {
            junctionBox.draw(g);
        }
    }
}

