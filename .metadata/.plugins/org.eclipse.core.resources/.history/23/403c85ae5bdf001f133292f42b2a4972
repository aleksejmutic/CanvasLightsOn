package canvas;

import java.awt.*;
import java.util.ArrayList;

public class Wire {
    private ArrayList<Point> points;

    public Wire(Point startPoint) {
        points = new ArrayList<>();
        points.add(startPoint);
    }

    public void addOrthogonalSegment(Point newPoint) {
        if (points.isEmpty()) {
            points.add(newPoint);
            return;
        }

        Point lastPoint = points.get(points.size() - 1);

        // Create horizontal-then-vertical path
        Point intermediatePoint = new Point(newPoint.x, lastPoint.y);
        points.add(intermediatePoint);
        points.add(newPoint);
    }

    public void updateLastPoint(Point point) {
        if (points.size() >= 2) {
            points.set(points.size() - 1, point);
            points.set(points.size() - 2, new Point(point.x, points.get(points.size() - 3).y));
        } else if (!points.isEmpty()) {
            points.set(points.size() - 1, point);
        }
    }

    public void draw(Graphics g) {
        g.setColor(Color.BLACK);
        for (int i = 0; i < points.size() - 1; i++) {
            Point p1 = points.get(i);
            Point p2 = points.get(i + 1);
            g.drawLine(p1.x, p1.y, p2.x, p2.y);
        }
    }
}
