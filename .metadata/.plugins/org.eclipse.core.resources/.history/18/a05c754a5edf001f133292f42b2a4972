package canvas;

import java.awt.*;
import java.util.ArrayList;

public class Wire {
    private ArrayList<Point> points;               // Points used for drawing
    private JunctionPoint startJunction;           // Starting JunctionPoint
    private JunctionPoint endJunction;             // Ending JunctionPoint
    private ArrayList<Point> userDefinedPoints;    // Points added by the user during drawing

    public Wire(JunctionPoint startJunction) {
        this.startJunction = startJunction;
        points = new ArrayList<>();
        userDefinedPoints = new ArrayList<>();
        points.add(new Point(startJunction.getX(), startJunction.getY()));
    }

    public void setEndJunction(JunctionPoint endJunction) {
        this.endJunction = endJunction;
        recalculatePath();
    }

    public void addUserDefinedPoint(Point point) {
        userDefinedPoints.add(point);
        recalculatePath();
    }

    public void recalculatePath() {
        points.clear();
        Point startPoint = new Point(startJunction.getX(), startJunction.getY());
        points.add(startPoint);

        Point previousPoint = startPoint;
        for (Point userPoint : userDefinedPoints) {
            // Create orthogonal segment from previousPoint to userPoint
            Point intermediatePoint = new Point(userPoint.x, previousPoint.y);
            points.add(intermediatePoint);
            points.add(new Point(userPoint.x, userPoint.y));
            previousPoint = userPoint;
        }

        // Connect to the end junction
        if (endJunction != null) {
            Point endPoint = new Point(endJunction.getX(), endJunction.getY());
            // Create orthogonal segment from last user point (or start point) to end point
            Point intermediatePoint = new Point(endPoint.x, previousPoint.y);
            points.add(intermediatePoint);
            points.add(endPoint);
        }
    }

    public void updateIfConnected(JunctionBox movedBox) {
        if ((startJunction != null && startJunction.getParentBox() == movedBox) ||
            (endJunction != null && endJunction.getParentBox() == movedBox)) {
            recalculatePath();
        }
    }

    public void draw(Graphics g) {
        g.setColor(Color.BLACK);
        for (int i = 0; i < points.size() - 1; i++) {
            Point p1 = points.get(i);
            Point p2 = points.get(i + 1);
            g.drawLine(p1.x, p1.y, p2.x, p2.y);
        }
    }

    public ArrayList<Point> getPoints() {
        return points;
    }
}
	